# Order Management - Variables de entorno
# Copiar a .env y configurar según el entorno

# Base de datos PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/order_management

# Para migraciones Alembic (síncrono)
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/order_management

# Configuración de la aplicación
DEBUG=false
LOG_LEVEL=INFO
